{
  "visual_enhancement_plan": {
    "schema_version": "1.0",
    "plan": {
      "required": [
        "schema_version",
        "vx_id",
        "project_id",
        "variation_index",
        "inputs",
        "output",
        "style",
        "intensity",
        "palette",
        "brand_kit",
        "safe_zone",
        "caption",
        "settings",
        "elements",
        "validation"
      ],
      "inputs": "brief {id, version}, script_version, storyboard_version, audio_package {id, version_id}, video {edit_id, version_id, edl_hash, approval_id}",
      "output": "{aspect_ratio, width, height, fps, duration (s), frames}"
    },
    "element": {
      "id": "unique id",
      "type": [
        "caption",
        "hook",
        "benefit",
        "feature",
        "price",
        "offer",
        "cta",
        "effect",
        "logo"
      ],
      "track": [
        "captions",
        "hook",
        "features",
        "benefits",
        "promo",
        "cta",
        "effects",
        "branding"
      ],
      "text": "string",
      "lines": "string[]",
      "words": "caption words [{text, start, end, hl?, timing}]",
      "start": "s (ms precision)",
      "end": "s",
      "start_frame": "int",
      "end_frame": "int",
      "position": "{x, y} centre, fractions of the frame + preset",
      "size": "{w, h} estimated fractions",
      "max_width": "fraction",
      "font": "{key, family, size (fraction of height), uppercase, weight}",
      "colors": "{text, highlight, outline, accent}",
      "outline": "{width, color}",
      "shadow": "{depth, color, opacity}",
      "background": "{mode none|box, color, opacity, padding}",
      "animation": "{type static|fade|slide_up|slide_in|pop|bounce|scale_emphasis|word_reveal|karaoke, in_ms, out_ms, pulse?}",
      "template": "from the template lists",
      "layer": "int",
      "segment_id": "script segment",
      "clip_id": "Module 6 clip",
      "visibility": "{enabled, rule}",
      "locked": "bool",
      "edited": "bool",
      "source": "voiceover|ai|brief|brand_kit|team",
      "purpose": "why it is there"
    }
  },
  "visual_director_answer": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "visual_style",
      "style_id",
      "style_reason",
      "intensity",
      "intensity_reason",
      "palette",
      "caption_segmentation",
      "caption_position",
      "keywords",
      "hook",
      "benefits",
      "price",
      "offer",
      "cta",
      "effects",
      "warnings",
      "summary"
    ],
    "properties": {
      "visual_style": {
        "type": "string"
      },
      "style_id": {
        "type": "string",
        "enum": [
          "hormozi",
          "modern_bold",
          "karaoke",
          "minimal",
          "luxury",
          "dynamic_pop",
          "social_ugc"
        ]
      },
      "style_reason": {
        "type": "string"
      },
      "intensity": {
        "type": "string",
        "enum": [
          "minimal",
          "balanced",
          "dynamic"
        ]
      },
      "intensity_reason": {
        "type": "string"
      },
      "palette": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "primary",
          "accent",
          "text",
          "reason"
        ],
        "properties": {
          "primary": {
            "type": "string"
          },
          "accent": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "caption_segmentation": {
        "type": "string",
        "enum": [
          "word",
          "two",
          "three",
          "phrase",
          "sentence"
        ]
      },
      "caption_position": {
        "type": "string",
        "enum": [
          "top",
          "upper_middle",
          "center",
          "lower_middle",
          "bottom",
          "auto"
        ]
      },
      "keywords": {
        "type": "array",
        "maxItems": 14,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "kind"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "benefit",
                "product",
                "feature",
                "price",
                "offer",
                "pain",
                "hook",
                "cta"
              ]
            }
          }
        }
      },
      "hook": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "show",
          "text",
          "template",
          "keyword",
          "reason"
        ],
        "properties": {
          "show": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "bold_headline",
              "question_headline",
              "highlighted_keyword",
              "minimal_premium",
              "animated_reveal",
              "benefit_headline"
            ]
          },
          "keyword": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "benefits": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "segment_id",
            "template",
            "source_text",
            "reason"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "segment_id": {
              "type": "string"
            },
            "template": {
              "type": "string",
              "enum": [
                "label",
                "badge",
                "card",
                "highlight_line",
                "callout"
              ]
            },
            "source_text": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "price": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "show",
          "template"
        ],
        "properties": {
          "show": {
            "type": "boolean"
          },
          "template": {
            "type": "string",
            "enum": [
              "price_card",
              "offer_badge",
              "premium_price",
              "promo_banner",
              "bundle_card",
              "price_reveal"
            ]
          }
        }
      },
      "offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "show",
          "template"
        ],
        "properties": {
          "show": {
            "type": "boolean"
          },
          "template": {
            "type": "string",
            "enum": [
              "price_card",
              "offer_badge",
              "premium_price",
              "promo_banner",
              "bundle_card",
              "price_reveal"
            ]
          }
        }
      },
      "cta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "template",
          "reason"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "order_now_text",
              "shop_now_pill",
              "showcase_cta",
              "price_cta",
              "minimal_premium",
              "cod_card",
              "promo_card"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "effects": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "enum": [
            "gradient_band",
            "accent_line",
            "card_reveal",
            "highlight_pulse",
            "cta_pulse",
            "banner_slide",
            "keyword_scale"
          ]
        }
      },
      "warnings": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      }
    }
  },
